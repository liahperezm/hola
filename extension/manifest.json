{
  "manifest_version": 3,
  "name": "Hola · Traductor de dialectos",
  "short_name": "Hola",
  "version": "0.2.0",
  "description": "Traduce la página entera al español de otro país, o desde otros idiomas, como el traductor del navegador.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Traducir con Hola",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+H", "mac": "Alt+Shift+H" },
      "description": "Abrir Hola"
    }
  }
}
