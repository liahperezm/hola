# Server-side key for the AI fallback (dictionary misses and reading photos).
# Without it the app still translates everything in the built-in dictionary.
ANTHROPIC_API_KEY=

# Where "Sugerir una palabra o corrección" in Ajustes sends email. Leave empty
# to hide that option.
NEXT_PUBLIC_FEEDBACK_EMAIL=

# Suggestions from users become GitHub issues labeled "sugerencia" in this
# repository. Use a fine-grained token with "Issues: Read and write" on this
# repository only. Without both, the app falls back to NEXT_PUBLIC_FEEDBACK_EMAIL
# or hides the suggestion form.
SUGGESTIONS_GITHUB_REPO=liahperezm/hola
SUGGESTIONS_GITHUB_TOKEN=

# Learner mode (English ⇄ a country's Spanish). A translation service does
# English ⇄ standard Spanish and Hola's dictionary makes it local. With no key
# it uses MyMemory (free, about 5,000 characters a day; set MYMEMORY_EMAIL to
# a contact address for 50,000). For more, set one of:
#   DEEPL_API_KEY=                 DeepL, free plan 500,000 characters a month
#   AZURE_TRANSLATOR_KEY= and AZURE_TRANSLATOR_REGION=   Microsoft, free 2 million a month
# LEARNER_ENGINE=ai uses Claude instead (needs ANTHROPIC_API_KEY; costs per use).
MYMEMORY_EMAIL=
